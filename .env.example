# Copy to .env and fill in. Never commit .env.

# Your institution API key, created in the AxLink portal (Developers -> API keys).
# The key decides the environment: axlk_test_... = sandbox, axlk_live_... = production.
AXLINK_API_KEY=axlk_test_replace_me

# The AxLink host. The client appends /api/v1. Sandbox and production use the same host.
AXLINK_BASE_URL=https://axlink.appraglobal.com

# Request timeout in milliseconds (optional, default 30000).
# AXLINK_TIMEOUT_MS=30000

# The demo refuses every write with a production (axlk_live_...) key unless this is true.
ALLOW_PRODUCTION_WRITES=false

# URL the demo registers as a webhook endpoint (and deletes again). Must be a public https URL.
# AXLINK_DEMO_WEBHOOK_URL=https://your-bank.example.com/webhooks/axlink

# Webhook receiver (npm run webhooks): the secret returned once when you created the endpoint.
AXLINK_WEBHOOK_SECRET=whsec_replace_me
# WEBHOOK_PORT=8787
